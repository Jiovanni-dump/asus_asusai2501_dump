#          ( trigger on sys.asus.dongletype=* )
# service
#           ****DO NOT insert service***     
###+++++++++++++++++++++++++++++++++++++++++++++++###


###+++++++++++++++++++++++++++++++++++++++++++++++###
#         ROG dongle property trigger (end)
#          ( trigger on sys.asus.dongletype=* )
# service
#           ****DO NOT insert service***     
###+++++++++++++++++++++++++++++++++++++++++++++++###

#####################################################
#####################################################
#####################################################

###+++++++++++++++++++++++++++++++++++++++++++++++###
#        ROG dongle property trigger (start)
#          ( trigger on sys.asus.dongletype=* )
#
#       ****DO NOT insert any services***
#
#       0 : No Dongle
#       1 : InBox
#       2 : Station
#       3 : DT
#       4 : Error type
#
###+++++++++++++++++++++++++++++++++++++++++++++++###

on property:vendor.asus.dongletype=*
	start rogaccyswitch
	start audio_inbox_service

on property:vendor.asus.dongletype=0
	start rogaccyremove

# Fan8
on property:vendor.asus.dongletype=10

	chmod 0664 /sys/class/leds/aura_inbox/mode
	chmod 0664 /sys/class/leds/aura_inbox/mode2
	chmod 0664 /sys/class/leds/aura_inbox/apply
	chmod 0664 /sys/class/leds/aura_inbox/led_on
#	chmod 0664 /sys/class/leds/aura_inbox/door_on
#	chmod 0664 /sys/class/leds/aura_inbox/logo_on
