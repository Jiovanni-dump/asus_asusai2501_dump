	chmod 0664 /sys/class/leds/aura_inbox/red2_pwm
	chmod 0664 /sys/class/leds/aura_inbox/green2_pwm
	chmod 0664 /sys/class/leds/aura_inbox/blue2_pwm
	chmod 0664 /sys/class/leds/aura_inbox/speed
	chmod 0664 /sys/class/leds/aura_inbox/frame
	chmod 0664 /sys/class/leds/aura_inbox/unique_id
	chmod 0664 /sys/class/leds/aura_inbox/aura_lpm_mode
	chmod 0664 /sys/class/leds/aura_inbox/keyboard_mode
	chmod 0664 /sys/class/leds/aura_inbox/PCBID1
	chmod 0664 /sys/class/leds/aura_inbox/PCBID2
	chmod 0664 /sys/class/leds/aura_inbox/gpio11

	chown system system /sys/class/leds/aura_inbox/mode
	chown system system /sys/class/leds/aura_inbox/mode2
	chown system system /sys/class/leds/aura_inbox/apply
	chown system system /sys/class/leds/aura_inbox/led_on
