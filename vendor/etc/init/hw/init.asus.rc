	chmod 0664 /sys/class/leds/aura_inbox/fw_ver
	chmod 0664 /sys/class/leds/aura_inbox/fw_mode
	chmod 0664 /sys/class/leds/aura_inbox/fw_update
	chmod 0664 /sys/class/leds/aura_inbox/ap2ld
