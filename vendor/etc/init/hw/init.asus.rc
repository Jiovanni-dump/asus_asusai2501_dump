#################################################################
#
#   	              ASUS USER RC
#
#################################################################
# ASUS Debug
import /vendor/etc/init/hw/init.asus.debugtool.rc

#################################
#
#   	booting on trigger
#
# ****DO NOT insert any services***     
#
#################################
on boot

# adding big/little cpu affinity ---
    mkdir /dev/stune/nonprime-aff
    chown system system /dev/stune/nonprime-aff
    chmod 0664 /dev/stune/nonprime-aff/tasks

    mkdir /dev/cpuset/nonprime-aff
    write /dev/cpuset/nonprime-aff/cpus 0-5
    write /dev/cpuset/nonprime-aff/mems 0
    chown system system /dev/cpuset/nonprime-aff
    chown system system /dev/cpuset/nonprime-aff/tasks
    chmod 0660 /dev/cpuset/nonprime-aff/tasks
    
    mkdir /dev/stune/prime-aff
    chown system system /dev/stune/prime-aff
    chmod 0664 /dev/stune/prime-aff/tasks

    mkdir /dev/cpuset/prime-aff
    write /dev/cpuset/prime-aff/cpus 6-7
    write /dev/cpuset/prime-aff/mems 0
    chown system system /dev/cpuset/prime-aff
    chown system system /dev/cpuset/prime-aff/tasks
    chmod 0660 /dev/cpuset/prime-aff/tasks

    restorecon_recursive /dev/cpuset/prime-aff/
    restorecon_recursive /dev/cpuset/nonprime-aff/
    
    mkdir /config/qcom_mpam/video
    mkdir /config/qcom_mpam/camera
    mkdir /config/qcom_mpam/game
    mkdir /config/qcom_mpam/benchmark
    
##############################################################
    setprop vendor.asus.accy.fw_status  000000
    setprop vendor.asus.accy.fw_status2 000000
    setprop vendor.asus.accy.fw_status3 000000
    setprop vendor.asus.accy.fw_status4 000000
##############################################################

on charger
#set cos flag
    wait /sys/class/asuslib/enter_cos
    write  /sys/class/asuslib/enter_cos 1

#disable sepolicy 
    write  /sys/fs/selinux/log 1

#+++ ASUS_BSP : add for mount asdf in COS mode
    wait /dev/block/bootdevice/by-name/asdf
    mount ext4 /dev/block/bootdevice/by-name/asdf /asdf nosuid nodev noatime barrier=1
    chmod 0775 /asdf
    restorecon_recursive /asdf

    write /proc/asusevtlog  "ASDF: Check LastShutdown log."
    write /proc/asusdebug  get_asdf_log
    write /proc/asusevtlog "charger: enter charger mode"
    write /asdf/CHGLimit 0
    write /sys/fs/selinux/log 1

    start logd
    start logcat-charger
    start bat_bs
    start bat_safety
    start ASUSEvtlog
    start thermal-engine
#--- ASUS_BSP : add for mount asdf in COS mode

# ASUS_BSP add cos_charger_limit +++
    chmod 0666 /dev/kmsg
    write /proc/asusevtlog  "ASUS RC : mount /batinfo"
	mkdir /batinfo
    wait /dev/block/bootdevice/by-name/batinfo
    exec /system/bin/e2fsck -p /dev/block/bootdevice/by-name/batinfo
    mount ext4 dev/block/bootdevice/by-name/batinfo /batinfo rw wait nosuid nodev noatime barrier=1
    chown system system /batinfo
    chown root system /batinfo/cos_charger_limit
    chmod 0777 /batinfo
    chmod 0777 /batinfo/cos_charger_limit
    restorecon_recursive /batinfo
	
	wait /batinfo/cos_charger_limit
    start cos_charger_limit_restore	
# ASUS_BSP add cos_charger_limit ---

on early-init

on init

on fs
chmod 660 /dev/kmsg
setprop vendor.asus.DisableInbox8Fwupdate 0
setprop vendor.asus.DisableInbox9Fwupdate 0
start ec_ueventd

on post-fs
    start checkaccyasusfwver

on post-fs-data
# +++ ASUS_BSP : add for asus battery safety upgrade and health partition
#mount batinfo
    wait /dev/block/bootdevice/by-name/batinfo
    exec /system/bin/e2fsck -p /dev/block/bootdevice/by-name/batinfo
    mount ext4 /dev/block/bootdevice/by-name/batinfo /batinfo nosuid nodev noatime barrier=1
    chown shell root /batinfo
    chmod 0777 /batinfo
    chmod 0777 /batinfo/.bs
    chmod 0777 /batinfo/bat_safety
    chown root system /batinfo/cos_charger_limit
    chmod 0777 /batinfo/cos_charger_limit
    chown root system /batinfo/serial_number_date
    chmod 0777 /batinfo/serial_number_date
    chown root system /batinfo/battery_activate_date
    chmod 0777 /batinfo/battery_activate_date
    chown root system /batinfo/bat_serial_number_date
    chmod 0777 /batinfo/bat_serial_number_date
    chown root system /batinfo/bat_serial_number
    chmod 0777 /batinfo/bat_serial_number
    chown root system /batinfo/FAC_bat_serial_number
    chmod 0777 /batinfo/FAC_bat_serial_number
    restorecon_recursive /batinfo
# --- ASUS_BSP : add for asus battery safety upgrade and health partition

# ASUS_BSP : add for trigger ftm mode
    setprop ro.boot.ftm  ${ro.boot.pre-ftm}    

# +++ ASUS_BSP : adb enable property
    setprop factory.adbon ${ro.boot.adb.enable}
    setprop factory.adbon2 ${ro.boot.adb.enable}
# --- ASUS_BSP : adb enable property

# +++ ASUS_BSP : Miniled +++
    chown system system /sys/class/leds/miniled/VDD
    chown system system /sys/class/leds/miniled/led_ldo
    chown system system /sys/class/leds/miniled/FW_Ver
    chown system system /sys/class/leds/miniled/FW_Update
    chown system system /sys/class/leds/miniled/PD6
    chmod 0664 /sys/class/leds/miniled/VDD
    chmod 0664 /sys/class/leds/miniled/led_ldo
    chmod 0664 /sys/class/leds/miniled/FW_Ver
    chmod 0664 /sys/class/leds/miniled/FW_Update
    chmod 0664 /sys/class/leds/miniled/PD6

#    chown system system /sys/class/leds/miniled/power
    chown system system /sys/class/leds/miniled/commit
    chown system system /sys/class/leds/miniled/speed
    chown system system /sys/class/leds/miniled/sleep
    chown system system /sys/class/leds/miniled/idle_update
    chown system system /sys/class/leds/miniled/idle_mode
#    chmod 0664 /sys/class/leds/miniled/power
    chmod 0664 /sys/class/leds/miniled/commit
    chmod 0664 /sys/class/leds/miniled/speed
    chmod 0664 /sys/class/leds/miniled/sleep
    chmod 0664 /sys/class/leds/miniled/idle_update
    chmod 0664 /sys/class/leds/miniled/idle_mode

    chown system system /sys/class/leds/miniled/test
    chmod 0664 /sys/class/leds/miniled/test
    chown system system /sys/class/leds/miniled/tmp_pattern
    chmod 0664 /sys/class/leds/miniled/tmp_pattern
# --- ASUS_BSP : Miniled ---

# +++ ASUS_BSP : add persist.asus.serialno for CSCMMI
#    setprop persist.asus.serialno ${ro.boot.serialno}
# --- ASUS_BSP : add persist.asus.serialno for CSCMMI

# ANAS++ turn on / off modem RF power when airplane mode change
    chown radio radio /sys/devices/platform/soc/4080000.remoteproc-mss/rf_power

# ASUS_BSP Paul +++
    mkdir /mnt/vendor/persist/audio 0770 root audio
    chown root audio /mnt/vendor/persist/audio/rcv_cal_val
    chown root audio /mnt/vendor/persist/audio/spk_cal_val
    chmod 0660 /mnt/vendor/persist/audio/rcv_cal_val
    chmod 0660 /mnt/vendor/persist/audio/spk_cal_val
# ASUS_BSP Paul ---

# ASUS_BSP +++ WIFI
    start wifimacsh
# ASUS_BSP --- WIFI

# +++ ASUS_BSP : change golden file permission
    chmod 0666 /mnt/vendor/persist/sensors/registry/alsps_golden
# --- ASUS_BSP : change golden file permission

#####################################################
#####################################################
#####################################################

###+++++++++++++++++++++++++++++++++++++++++++++++###
#        FTM Mode property trigger (start)
#          ( trigger on ro.boot.ftm=1 )
#
#       ****DO NOT insert any services***     
###+++++++++++++++++++++++++++++++++++++++++++++++###

on property:ro.boot.ftm=1 && property:sys.boot_completed=1
    setprop ro.setupwizard.mode DISABLED


###-----------------------------------------------###
#         FTM Mode property trigger (end)
#          ( trigger on ro.boot.ftm=1 )
#
#       ****DO NOT insert any services***     
###-----------------------------------------------###

