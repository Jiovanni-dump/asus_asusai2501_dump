#	chown system system /sys/class/leds/aura_inbox/temperature
#	chown system system /sys/class/leds/aura_inbox/humidity

	chmod 0664 /sys/class/leds/aura_inbox/ambient_temperature
	chown system system /sys/class/leds/aura_inbox/ambient_temperature

	chmod 0664 /sys/class/leds/aura_inbox/get_FAN_HWID
	chown system system /sys/class/leds/aura_inbox/get_FAN_HWID
	chmod 0664 /sys/class/leds/aura_inbox/get_FAN_PJID
