###+++++++++++++++++++++++++++++++++++++++++++++++###
#               ALL ASUS on property  (start)
# 
#           ****DO NOT insert service***     
###+++++++++++++++++++++++++++++++++++++++++++++++###

on property:persist.vendor.zram.enable=*
    start asus_zram

on property:vendor.init.zram.enable=*
    setprop persist.vendor.zram.enable ${vendor.init.zram.enable}

on property:vendor.perf.log_stop=1
    stop logd
    stop ASUSEvtlog
on property:vendor.perf.log_stop=0
    start logd
    start ASUSEvtlog

on property:vendor.grip.fw.fail.count=1
	start GripReadFWStatus

on property:vendor.grip.i2c.fail.count=1
	start GripReadI2cStatus

# ASUS_BSP : Miniled +++
on property:sys.boot_completed=1
    start MiniledFWupdate

on property:vendor.phone.miniled_fwupdate=1
    start MiniledFWupdate

on property:debug.asus.csc.miniledtest=*
    start MiniledATDTest

on property:debug.asus.miniled.vdd=*
    write /sys/class/leds/miniled/VDD ${debug.asus.miniled.vdd}
# ASUS_BSP : Miniled ---

# ASUS_BSP : SLE97 ATD test +++
on property:debug.asus.atd.sletest=1
    start SLETest
# ASUS_BSP : SLE97 ATD test ---

#for log tool switch usb+++
on property:vendor.asus.usb.diag=1
    setprop vendor.usb.diag 1

on property:vendor.asus.usb.diag=0
    setprop vendor.usb.diag 0
#for log tool switch usb---

# ASUS_BSP+++ set sim type
on property:ro.boot.id.nfc=2
    setprop ro.vendor.odm.tel.simtype 1

on property:ro.boot.id.nfc=3
    setprop ro.vendor.odm.tel.simtype 1

on property:ro.boot.id.nfc=7
    setprop ro.vendor.odm.tel.simtype 1
# ASUS_BSP--- set sim type

# ASUS_BSP Touch +++
on property:sys.boot_completed=1
    start touch_ver

on property:vendor.asus.gamingtype=*
    start game_type_edge

on property:vendor.asus.gamingtype=*
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_game_mode ${vendor.asus.gamingtype}

on property:sys.asus.touch.disablegrip=*
	setprop vendor.asus.touch.disablegrip ${sys.asus.touch.disablegrip}

on property:vendor.asus.touch.disablegrip=*
	write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/disable_antitouch_mode ${vendor.asus.touch.disablegrip}

on property:vendor.asus.touch_control_fod=0
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_fp_ctrl_mode 0
on property:vendor.asus.touch_control_fod=1
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_fp_ctrl_mode 1
on property:vendor.asus.touch_control_fod=2
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_fp_ctrl_mode 2

on property:persist.vendor.asus.fp.wakeup=true
   write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_fp_mode 1
on property:persist.vendor.asus.fp.wakeup=false
   write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_fp_mode 0

on property:vendor.asus.touch_control_aod=0
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_aod_ctrl_mode 0
on property:vendor.asus.touch_control_aod=1
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_aod_ctrl_mode 1

on property:vendor.goodix.sensor.status=*
	write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fp_auth_status ${vendor.goodix.sensor.status}

on property:debug.asus.touch.report_rate=*
    setprop vendor.asus.touch.report_rate ${debug.asus.touch.report_rate}

on property:sys.asus.touch.report_rate=*
    setprop vendor.asus.touch.report_rate ${sys.asus.touch.report_rate}

on property:vendor.asus.touch.report_rate=*
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/rise_report_rate ${vendor.asus.touch.report_rate}

on property:sys.asus.touch.game_settings=*
    setprop vendor.asus.touch.game_settings ${sys.asus.touch.game_settings}

on property:vendor.asus.touch.game_settings=*
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/game_settings ${vendor.asus.touch.game_settings}

on property:sys.asus.touch.edge_settings=*
    setprop vendor.asus.touch.edge_settings ${sys.asus.touch.edge_settings}

on property:vendor.asus.touch.edge_settings=*
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/edge_settings ${vendor.asus.touch.edge_settings}

on property:sys.asus.sar.audio=*
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_phone_state ${sys.asus.sar.audio}

on property:vendor.asus.touch.extra_config=*
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_extra_config  ${vendor.asus.touch.extra_config}

on property:sys.boot_completed=1
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/keymapping_touch
    chmod 0777 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/keymapping_touch
    restorecon /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/keymapping_touch
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/rise_report_rate
    chmod 0777 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/rise_report_rate
    restorecon /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/rise_report_rate
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/game_settings
    chmod 0777 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/game_settings
    restorecon /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/game_settings
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_rotation_mode
    chmod 0777 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_rotation_mode
    restorecon /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_rotation_mode
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/edge_settings
    chmod 0777 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/edge_settings
    restorecon /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/edge_settings
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_rotation_mode
    chmod 0777 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_rotation_mode
    restorecon /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_rotation_mode
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fod_key_received
    chmod 0777 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fod_key_received
    restorecon /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fod_key_received
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_extra_config
    chmod 0777 /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_extra_config
    restorecon /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fts_extra_config

on property:sys.asus.touch.fp_enable_suppression=*
	setprop vendor.asus.touch.fp_enable_suppression ${sys.asus.touch.fp_enable_suppression}

on property:vendor.asus.touch.fp_enable_suppression=*
	write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm.0/fp_enable_suppression ${vendor.asus.touch.fp_enable_suppression}
# ASUS_BSP Touch ---

# apply cta property to radio can access
on property:ro.vendor.build.cta=1
    setprop ro.vendor.odm.tel.cta 1

# ASUS_BSP +++ WIFI

on property:vendor.asus.wfd.config=*
    setprop vendor.asus.wfd2.config ${vendor.asus.wfd.config}

on property:vendor.wlan.softap.driver.status=ok
    write /proc/driver/UTSstatus 1

on property:vendor.wlan.softap.driver.status=unloaded
    write /proc/driver/UTSstatus 0

# ASUS_BSP+++ for wlan miracast log
on property:persist.vendor.asus.miracastlog=1
    setprop debug.wfd.uibcevents 1
    write /data/vendor/mmosal_logmask.cfg "LOGMASK = 6013:63\\nLOGMASK = 6015:63"
    chmod 666 /data/vendor/mmosal_logmask.cfg

on property:persist.vendor.asus.miracastlog=0
    setprop debug.wfd.uibcevents 0
    rm /data/vendor/mmosal_logmask.cfg
# ASUS_BSP--- for wlan miracast log

on property:persist.vendor.asus.cnelog=1
    setprop persist.vendor.cne.logging.qxdm 3974

on property:persist.vendor.asus.cnelog=0
    setprop persist.vendor.cne.logging.qxdm 4242

on property:vendor.camera.WifiInfo=*
    restart WifiSAR

on property:vendor.asus.operator.iso-country=*
    restart WifiSAR

on property:wlan.driver.status=*
    restart WifiSAR

on property:vendor.wlan.softap.driver.status=*
    restart WifiSAR

# ASUS_BSP --- WIFI

#ASUS_BSP Battery +++
on property:sys.boot_completed=1
   start battery_ver
   start gauge_fw_compare
   start battery_activate_date_restore
   start bat_serial_number_restore
   start bat_serial_number_restore2
   setprop vendor.charger.limit.restore 1
   setprop vendor.battery.serial_number.restore 1
   chmod 777 /sys/class/asuslib/enter_ship_mode

on property:vendor.battery.serial_number.backup=1
   start bat_serial_number_backup

on property:vendor.battery.serial_number.restore=1
   start bat_serial_number_restore
   start bat_serial_number_restore2

on property:vendor.battery.serial_number.date=*
    start bat_serial_number_backup2
    start bat_serial_number_restore2
    start battery_activate_date_restore

on property:vendor.charger.limit=*
    start cos_charger_limit_backup
on property:vendor.charger.limit.restore=1
    start cos_charger_limit_restore
on property:persist.sys.charger.limit.level=*
    setprop vendor.charger.limit ${persist.sys.charger.limit.level}

# batterylock +++
on property:ro.boot.batterylock=1
    wait /sys/class/asuslib/fg_set_shutdown
    write /sys/class/asuslib/fg_set_shutdown 1

on property:sys.battery.shutdown=1
	setprop sys.boot.reason "reboot,batterylock"
    setprop sys.powerctl "reboot,batterylock"
# batterylock ---

# EnterShippingMode by ABL +++
on property:ro.boot.shippingmode=1
    wait /sys/class/asuslib/enter_ship_mode
    write /sys/class/asuslib/enter_ship_mode 1
# EnterShippingMode by ABL ---

#ASUS_BSP Battery ---

#ASUS_BSP Charger ++++
#Add the inteface with ASUS userspace +++
on property:persist.sys.stopcharging=1
	write /sys/class/asuslib/smartchg_stop_charging 1
on property:persist.sys.stopcharging=0
	write /sys/class/asuslib/smartchg_stop_charging 0
on property:persist.sys.bypasscharging=1
	write /sys/class/asuslib/bypass_stop_charging 1
on property:persist.sys.bypasscharging=0
	write /sys/class/asuslib/bypass_stop_charging 0

#Add for slow charging
# Rev 1.0 of slow charging
on property:persist.sys.slowcharging=1
	write /sys/class/asuslib/charger_limit_mode 1,10
on property:persist.sys.slowcharging=0
	write /sys/class/asuslib/charger_limit_mode 1,0
# Rev 2.0 of slow charging
on property:persist.sys.charginglimit=9
	write /sys/class/asuslib/charger_limit_mode 1,9
on property:persist.sys.charginglimit=10
	write /sys/class/asuslib/charger_limit_mode 1,10
on property:persist.sys.charginglimit=12
	write /sys/class/asuslib/charger_limit_mode 1,12
on property:persist.sys.charginglimit=15
	write /sys/class/asuslib/charger_limit_mode 1,15
on property:persist.sys.charginglimit=18
	write /sys/class/asuslib/charger_limit_mode 1,18
on property:persist.sys.charginglimit=30
	write /sys/class/asuslib/charger_limit_mode 1,30
on property:persist.sys.charginglimit=45
	write /sys/class/asuslib/charger_limit_mode 1,45
on property:persist.sys.charginglimit=65
	write /sys/class/asuslib/charger_limit_mode 1,65
on property:persist.sys.charginglimit=0
	write /sys/class/asuslib/charger_limit_mode 1,0

# Add for ultra battery life
on property:persist.sys.ultrabatterylife=1
    write /sys/class/asuslib/ultra_bat_life 1
on property:persist.sys.ultrabatterylife=0
    write /sys/class/asuslib/ultra_bat_life 0

# Add for LPD enable control
on property:persist.sys.enableLPD=1
    write /sys/class/qcom-battery/moisture_detection_en 1
on property:persist.sys.enableLPD=0
    write /sys/class/qcom-battery/moisture_detection_en 0

on property:sys.boot_completed=1
     chmod 0666 /sys/class/asuslib/set_debugmask
     chmod 777 /d/regmap/0-07/address
     chmod 777 /d/regmap/0-07/data
     chmod 777 /d/regmap/2-07/address
     chmod 777 /d/regmap/2-07/data
     chmod 0777 /sys/class/asuslib/usbin_suspend_en
     chown system system /sys/class/asuslib/usbin_suspend_en
     chmod 777 /sys/class/asuslib/charger_limit_en
     chmod 777 /sys/class/asuslib/charger_limit_cap
     chmod 777 /sys/class/qcom-battery/ship_mode_en
     chmod 777 /sys/class/asuslib/enter_ship_mode
     chmod 777 /sys/class/asuslib/quick_ship_mode
     chmod 0777 /sys/class/asuslib/set_hawaii_LPD_mux_en
     chown system shell /sys/class/asuslib/set_hawaii_LPD_mux_en
     chmod 0777 /sys/class/asuslib/charger_limit_mode
     chown system shell /sys/class/asuslib/charger_limit_mode
     write /sys/class/asuslib/boot_completed 1
#ASUS_BSP Charger ---

on property:sys.boot_completed=1 && property:vendor.atd.oem-uart=0
	write /sys/class/asuslib/set_hawaii_LPD_mux_en 1

# ASUS_BSP Fan8 FW update +++
service inbox8pdfwupdate /vendor/bin/sh /vendor/etc/inbox8_pd_fw_update.sh
        seclabel u:r:rog_dongle:s0
        class core
        user root
        group root system
        oneshot
        disabled

on property:sys.fandg8.pd_fwupdate=1
	setprop vendor.fandg8.pd_fwupdate 1

on property:vendor.fandg8.pd_fwupdate=1
	start inbox8pdfwupdate

service inbox8aurafwupdate /vendor/bin/sh /vendor/etc/inbox8_aura_fw_update.sh
        seclabel u:r:rog_dongle:s0
        class core
        user root
        group root system
        oneshot
        disabled

on property:sys.fandg8.2led_fwupdate=1
	setprop vendor.fandg8.2led_fwupdate 1

on property:vendor.fandg8.2led_fwupdate=1
	start inbox8aurafwupdate
# ASUS_BSP Fan8 FW update ---

# ASUS_BSP Fan9 FW update +++
service inbox9pdfwupdate /vendor/bin/sh /vendor/etc/inbox9_pd_fw_update.sh
        seclabel u:r:rog_dongle:s0
        class core
        user root
        group root system
        oneshot
        disabled

on property:sys.fandg9.pd_fwupdate=1
	setprop vendor.fandg9.pd_fwupdate 1

on property:vendor.fandg9.pd_fwupdate=1
	start inbox9pdfwupdate

service inbox9aurafwupdate /vendor/bin/sh /vendor/etc/inbox9_aura_fw_update.sh
        seclabel u:r:rog_dongle:s0
        class core
        user root
        group root system
        oneshot
        disabled

on property:sys.fandg9.2led_fwupdate=1
	setprop vendor.fandg9.2led_fwupdate 1

on property:vendor.fandg9.2led_fwupdate=1
	start inbox9aurafwupdate
# ASUS_BSP Fan9 FW update ---

# add for read_cdn indicator
on property:sys.asusconfigupdater.policy_cdn_version.csv=*
    setprop vendor.policy_cdn ${sys.asusconfigupdater.policy_cdn_version.csv}

# ASUS_BSP : For Inbox Fan & Cooler control +++
on property:vendor.asus.fan.mic=*
	stop inboxfanrpm
	start inboxfanrpm

on property:persist.vendor.asus.micfansettings=*
	start inboxfanrpm

on property:persist.vendor.asus.userfanrpm=*
	start inboxfanrpm

on property:persist.vendor.asus.coolerstage_csc=*
	start inboxcoolerstagecsc

on property:persist.vendor.asus.coolerstage=*
	start inboxcoolerstage
# ASUS_BSP : For Inbox Fan & Cooler control ---

# ASUS_BSP : For FAN info to ADSP +++
on property:vendor.asus.fanusb=1
	write /sys/class/asuslib/is_fan_connected 1

on property:vendor.asus.fanusb=0
	write /sys/class/asuslib/is_fan_connected 0
# ASUS_BSP : For FAN info to ADSP ---

# ASUS_BPS Add for AuraLight HAL control +++
on property:vendor.asus.donglestate_GV_PD=0
	setprop vendor.asus.aura.gamepad none

on property:vendor.asus.donglestate_GV_PD=2
	setprop vendor.asus.aura.gamepad none
# ASUS_BPS Add for AuraLight HAL control ---

# ASUS_BSP Paul +++
on property:vendor.audio.agmcap.enabled=1
    start agmcap

on property:vendor.audio.agmhostless.enabled=0
    stop agmhostless
on property:vendor.audio.agmhostless.enabled=1
    start agmhostless

on property:vendor.audio.woofer.enabled=*
    write /sys/class/leds/aura_inbox/asus_woofer_media_en ${vendor.audio.woofer.enabled}

on property:vendor.audio.woofer.mode=*
    write /sys/class/leds/aura_inbox/asus_woofer_mode ${vendor.audio.woofer.mode}
# ASUS_BSP Paul ---

# Jessy +++
on property:ro.boot.id.prj=0
    setprop vendor.audio.enable_ozo_mic3 true
on property:ro.boot.id.prj=1
    setprop vendor.audio.enable_ozo_mic3 true
on property:ro.boot.id.prj=2
    setprop vendor.audio.enable_ozo_mic3 false
# Jessy ---

# ASUS_BSP camera+++
on property:sys.boot_completed=1
    chmod 777 /data/vendor/camera
    chmod 644 /vendor/factory/dualcam_cali_1x.bin
    copy /vendor/factory/dualcam_cali_1x.bin /data/vendor/camera/dualcam_cali_1x.bin
    chmod 0755 /data/vendor/camera/dualcam_cali_1x.bin
    chmod 644 /vendor/factory/dualcam_cali_2.8x.bin
    copy /vendor/factory/dualcam_cali_2.8x.bin /data/vendor/camera/dualcam_cali_2.8x.bin
    chmod 0755 /data/vendor/camera/dualcam_cali_2.8x.bin
    copy /vendor/lib64/camera/dualcam_cali_1x_G.bin /data/vendor/camera/dualcam_cali_1x_G.bin
    chmod 0755 /data/vendor/camera/dualcam_cali_1x_G.bin
    copy /vendor/lib64/camera/dualcam_cali_2.8x_G.bin /data/vendor/camera/dualcam_cali_2.8x_G.bin
    chmod 0755 /data/vendor/camera/dualcam_cali_2.8x_G.bin
    copy /vendor/factory/cali_IMX906_R.txt /data/vendor/camera/cali_IMX906_R.txt
    chmod 0755 /data/vendor/camera/cali_IMX906_R.txt
    copy /vendor/factory/cali_OV32C_R.txt /data/vendor/camera/cali_OV32C_R.txt
    chmod 0755 /data/vendor/camera/cali_OV32C_R.txt
    copy /vendor/factory/cali_OV13B_R.txt /data/vendor/camera/cali_OV13B_R.txt
    chmod 0755 /data/vendor/camera/cali_OV13B_R.txt
    copy /vendor/factory/cali_JD1_R.txt /data/vendor/camera/cali_JD1_R.txt
    chmod 0755 /data/vendor/camera/cali_JD1_R.txt
    copy /vendor/factory/cali_OV8856_R.txt /data/vendor/camera/cali_OV8856_R.txt
    chmod 0755 /data/vendor/camera/cali_OV8856_R.txt

    chmod 0755 /data/vendor/camera/IMX906_SN.txt
    chmod 0755 /data/vendor/camera/OV32C_SN.txt
    chmod 0755 /data/vendor/camera/OV13B_SN.txt
    chmod 0755 /data/vendor/camera/JD1_SN.txt
    chmod 0755 /data/vendor/camera/OV8856_SN.txt
    chown root root /data/vendor/camera/IMX906_SN.txt
    chown root root /data/vendor/camera/OV32C_SN.txt
    chown root root /data/vendor/camera/OV13B_SN.txt
    chown root root /data/vendor/camera/JD1_SN.txt
    chown root root /data/vendor/camera/OV8856_SN.txt

on property:vendor.camera.set.apk.usingname=*
	setprop vendor.camera.apk.usingname   ${vendor.camera.set.apk.usingname}

on property:vendor.camera.set.apk.activity=*
	setprop vendor.camera.apk.activity   ${vendor.camera.set.apk.activity}

on property:vendor.asus.dis_flash_light=1
	write /proc/driver/asus_flash "2 1"

on property:vendor.asus.dis_flash_light=0
	write /proc/driver/asus_flash "2 0"
# ASUS_BSP camera---

# ASUS_BSP NFC +++
on property:vendor.asus.nfc.felica=*
    start nfcfelica
# ASUS_BSP NFC ---

# ASUS_BSP +++ USB Host
on property:vendor.asus.usb.speed=2
	write /sys/bus/platform/devices/a600000.ssusb/speed high
on property:vendor.asus.usb.speed=3
	write /sys/bus/platform/devices/a600000.ssusb/speed ssp
# ASUS_BSP --- USB Host

# ASUS_BSP+++ Clay_Wang "For Grip Calibration"
on property:debug.grip.calibration=*
	start GripCalService
on property:debug.grip.cal_test_result=*
	start GripCalibration

on property:vendor.grip.fw.fail.count_read_user=*
	setprop persist.vendor.fail_cnt.grip ${vendor.grip.fw.fail.count_read_user}
on property:vendor.grip.i2c.fail.count_read=*
	setprop persist.vendor.fail_cnt.grip_i2c ${vendor.grip.i2c.fail.count_read}
on property:vendor.grip.fw.version=*
	setprop vendor.airtrigger.fw.version ${vendor.grip.fw.version}
on property:vendor.grip.fw.result=*
	setprop	vendor.airtrigger.fw.result	${vendor.grip.fw.result}
on property:vendor.grip.checkfpc=*
	start GripCheckK
on property:vendor.grip.reset_flag=*
   start GripCheckK
on property:vendor.grip.vib.en=*
	start GripCheckK
on property:vendor.airtrigger.get.chip_status=*
	start AT_chip_check
on property:vendor.grip.chip.status=*
	setprop vendor.airtrigger.chip.status ${vendor.grip.chip.status}

on property:sys.boot_completed=1
	start GripCheckK

on property:vendor.grip.selected_fw=*
	write /proc/driver/grip_select_fw_ver ${vendor.grip.selected_fw}
	
on property:persist.sys.grip.devSelected_fw=306
	write /proc/driver/grip_select_fw_ver 0000306
	
on property:persist.sys.grip.devSelected_fw=322
	write /proc/driver/grip_select_fw_ver 0000322			
# ASUS_BSP--- Clay_Wang "For Grip Calibration"

# ASUS_BSP Clay +++
on property:vendor.asus.proximity_aod=*
       write /sys/class/sensors/psensor/aod_mode ${vendor.asus.proximity_aod}

on property:debug.asus.atd.alsps_golden=*
       chmod 0666 /mnt/vendor/persist/sensors/registry/alsps_golden
       start PSENSOR_USER_CAL

on property:vendor.proximity.persist.alsps_golden=*
       setprop debug.asus.atd.persist.alsps_golden ${vendor.proximity.persist.alsps_golden}

on property:vendor.proximity.prox_raw=*
       setprop debug.asus.atd.prox_raw ${vendor.proximity.prox_raw}

on property:vendor.light.fail_cnt.ALSPS=*
       setprop persist.vendor.fail_cnt.ALSPS ${vendor.light.fail_cnt.ALSPS}
# ASUS_BSP Clay ---

# ASUS_BSP SLE Test +++
on property:sys.boot_completed=1
	chown shell system /sys/bus/spi/devices/spi1.0/sync
	chmod 0664 /sys/bus/spi/devices/spi1.0/sync
# ASUS_BSP SLE Test ---

# ASUS BSP Display +++
on property:vendor.debug.hdcp=1
	write /proc/driver/hdcp_disable 0

on property:vendor.debug.hdcp=0
	write /proc/driver/hdcp_disable 1

on property:sys.boot_completed=1
	write /proc/boot_comp 1
# ASUS BSP Display ---

on property:vendor.asus.period=*
	 setprop debug.asus.period ${vendor.asus.period}
on property:vendor.asus.vsync=*
	 setprop debug.asus.fsync ${vendor.asus.vsync}

# FSI Add for felicanetworks config files +++
on boot && property:ro.product.model=*
    mount none /vendor/etc/felica/${ro.product.model} /vendor/etc/felica bind
# FSI Add for felicanetworks config files ---

# ASUS_BSP : For GU200A Univeral App +++
on property:ro.vendor.build.asus.sku=WW
	setprop vendor.asus.gu200a.support 1

on property:ro.vendor.build.asus.sku=CN
	setprop vendor.asus.gu200a.support 1

on property:ro.vendor.build.asus.sku=ZWW
	setprop vendor.asus.gu200a.support 0
# ASUS_BSP : For GU200A Univeral App ---

