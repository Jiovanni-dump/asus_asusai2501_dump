###+++++++++++++++++++++++++++++++++++++++++++++++###
#        ROG dongle property trigger (start)
#          ( trigger on sys.asus.gamepadtype=* )
#
#       ****DO NOT insert any services***
#
#       0 : No Dongle
#       1 : Kunai
#       2 : GU200A
#
###+++++++++++++++++++++++++++++++++++++++++++++++###

on property:vendor.asus.gamepadtype=*
    start roggamepadswitch

on property:vendor.asus.gamepadtype=0
    setprop vendor.gamepad.auralight.support 0
    start roggamepadremove

# ASUS BSP : Kunai Gamepad +++
on property:vendor.asus.gamepadtype=1
    setprop vendor.gamepad.auralight.support 0

# ASUS BSP : GU200A +++
on property:vendor.asus.gamepadtype=2
    setprop vendor.gamepad.auralight.support 1

    chmod 0666 /sys/class/leds/aura_gamepad/red_pwm
	chmod 0666 /sys/class/leds/aura_gamepad/green_pwm
	chmod 0666 /sys/class/leds/aura_gamepad/blue_pwm
	chmod 0666 /sys/class/leds/aura_gamepad/rgb_pwm
    chmod 0666 /sys/class/leds/aura_gamepad/mode
    chmod 0666 /sys/class/leds/aura_gamepad/mode2
    chmod 0666 /sys/class/leds/aura_gamepad/apply
    chmod 0666 /sys/class/leds/aura_gamepad/fw_ver
    chmod 0666 /sys/class/leds/aura_gamepad/fw_mode
    chmod 0666 /sys/class/leds/aura_gamepad/led_on
    chmod 0666 /sys/class/leds/aura_gamepad/speed
    chmod 0666 /sys/class/leds/aura_gamepad/frame
    chmod 0666 /sys/class/leds/aura_gamepad/brightness_aura
    chmod 0666 /sys/class/leds/aura_gamepad/random
    chmod 0666 /sys/class/leds/aura_gamepad/rog_button
    chmod 0666 /sys/class/leds/aura_gamepad/key_remapping
    chmod 0666 /sys/class/leds/aura_gamepad/key_switch
    chmod 0666 /sys/class/leds/aura_gamepad/factory_reset

	chown root system /sys/class/leds/aura_gamepad/red_pwm
	chown root system /sys/class/leds/aura_gamepad/green_pwm
	chown root system /sys/class/leds/aura_gamepad/blue_pwm
	chown root system /sys/class/leds/aura_gamepad/rgb_pwm
    chown root system /sys/class/leds/aura_gamepad/mode
    chown root system /sys/class/leds/aura_gamepad/mode2
    chown root system /sys/class/leds/aura_gamepad/apply
    chown root system /sys/class/leds/aura_gamepad/fw_ver
    chown root system /sys/class/leds/aura_gamepad/fw_mode
    chown root system /sys/class/leds/aura_gamepad/led_on
    chown root system /sys/class/leds/aura_gamepad/speed
    chown root system /sys/class/leds/aura_gamepad/frame
    chown root system /sys/class/leds/aura_gamepad/brightness_aura
    chown root system /sys/class/leds/aura_gamepad/random
    chown root system /sys/class/leds/aura_gamepad/rog_button
    chown root system /sys/class/leds/aura_gamepad/key_remapping
    chown root system /sys/class/leds/aura_gamepad/key_switch
    chown root system /sys/class/leds/aura_gamepad/factory_reset
# ASUS BSP ROG dongle GU200A ---


